# Copia questo file in ".env" e compila solo i valori che ti servono.
# Le righe vuote vengono ignorate. Non inserire mai ".env" in Git.

ORIGIN_AIRPORT=CAG
CURRENCY=EUR
PASSENGERS=1
CABIN_CLASS=economy

MAX_STANDARD_PRICE_EUR=100
# Vuoto = nessun tetto monetario per le destinazioni esotiche (la classifica limita comunque la visualizzazione)
EXOTIC_MAX_PRICE_EUR=

SEARCH_HORIZON_DAYS=180
MIN_NIGHTS=1
MAX_NIGHTS=4

OUTBOUND_THURSDAY_EARLIEST=17:00
RETURN_MONDAY_LATEST=23:00
TIMEZONE=Europe/Rome

# Valori prudenti, non limiti imposti dal provider
API_RUN_BUDGET=25
API_MONTHLY_BUDGET=200
MAX_DESTINATIONS_TO_VERIFY=10
CACHE_TTL_HOURS=24
DISPLAY_LIMIT=30

DATABASE_PATH=data/flights.db
REPORT_DIRECTORY=reports

# Provider: SerpApi (piano gratuito: 250 ricerche/mese, 50/ora - verificare su serpapi.com/pricing)
SERPAPI_API_KEY=

# Amadeus: adapter predisposto ma disabilitato, vedi docs/API_RESEARCH.md
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Notifiche opzionali: lasciale vuote per disattivarle
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=
